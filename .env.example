IMA_MODE=paper
IMA_TIMEZONE=Asia/Hong_Kong
IMA_SNAPSHOT_DIR=scrapper/snapshots
IMA_ARTIFACT_DIR=artifacts/models
IMA_LEDGER_PATH=artifacts/ledger/predictions.sqlite
IMA_BANKROLL=10000
IMA_MAX_RACE_FRACTION=0.02
IMA_MAX_COMBINATION_FRACTION=0.005
IMA_MINIMUM_EDGE=0.02
IMA_MINIMUM_STAKE=10
IMA_STAKE_INCREMENT=10
IMA_OPTIMIZER_MODEL=openai/gpt-5.6-luna
IMA_OPTIMIZER_SERVICE_TIER=flex
# OPENROUTER_API_KEY must be supplied by the shell or vault, never committed.
# Account credentials must come from macOS Keychain or an external vault.
# Never place HKJC credentials in this file.
