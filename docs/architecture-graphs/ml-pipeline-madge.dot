digraph ML_Pipeline_Madge {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.45", ranksep="0.9", splines=true, overlap=false];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155", fillcolor="#f8fafc", margin="0.08,0.05"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b", arrowsize=0.7];
  subgraph cluster_n_cli___research_scripts {
    label="cli / research scripts";
    color="#cbd5e1"; style="rounded"; fontname="Helvetica"; fontsize=13;
    n_scripts_optimize_py [label="scripts/\noptimize.py", fillcolor="#eef2ff"];
    n_scripts_run_experiments_py [label="scripts/\nrun_experiments.py", fillcolor="#eef2ff"];
    n_scripts_run_benter_grid_py [label="scripts/\nrun_benter_grid.py", fillcolor="#eef2ff"];
