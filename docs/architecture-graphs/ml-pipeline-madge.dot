    n_scripts_train_py [label="scripts/\ntrain.py", fillcolor="#eef2ff"];
    n_scripts_export_mlflow_dashboard_py [label="scripts/\nexport_mlflow_dashboard.py", fillcolor="#eef2ff"];
    n_scripts_import_results_to_mlflow_py [label="scripts/\nimport_results_to_mlflow.py", fillcolor="#eef2ff"];
    n_scripts_enrich_pool_metrics_py [label="scripts/\nenrich_pool_metrics.py", fillcolor="#eef2ff"];
    n_scripts_publish_latest_dashboard_py [label="scripts/\npublish_latest_dashboard.py", fillcolor="#eef2ff"];
  }
  subgraph cluster_n_optimizer___agent_planner {
    label="optimizer / agent planner";
    color="#cbd5e1"; style="rounded"; fontname="Helvetica"; fontsize=13;
    n_ima_optimizer_py [label="ima/\noptimizer.py", fillcolor="#ecfeff"];
    n_ima_openrouter_orchestrator_py [label="ima/\nopenrouter_orchestrator.py", fillcolor="#ecfeff"];
  }
  subgraph cluster_n_experiment_orchestration {
    label="experiment orchestration";
    color="#cbd5e1"; style="rounded"; fontname="Helvetica"; fontsize=13;
    n_ima_experiments_py [label="ima/\nexperiments.py", fillcolor="#f0fdf4"];
    n_ima_training_py [label="ima/\ntraining.py", fillcolor="#f0fdf4"];
    n_ima_mlflow_tracking_py [label="ima/\nmlflow_tracking.py", fillcolor="#f0fdf4"];
    n_ima_pipeline_transparency_py [label="ima/\npipeline_transparency.py", fillcolor="#f0fdf4"];
  }
  subgraph cluster_n_data_and_features {
    label="data and features";
    color="#cbd5e1"; style="rounded"; fontname="Helvetica"; fontsize=13;
    n_ima_data_py [label="ima/\ndata.py", fillcolor="#fff7ed"];
    n_ima_feature_sets_py [label="ima/\nfeature_sets.py", fillcolor="#fff7ed"];
    n_ima_rich_features_py [label="ima/\nrich_features.py", fillcolor="#fff7ed"];
    n_ima_feature_analysis_py [label="ima/\nfeature_analysis.py", fillcolor="#fff7ed"];
    n_ima_auxiliary_py [label="ima/\nauxiliary.py", fillcolor="#fff7ed"];
  }
  subgraph cluster_n_modeling_and_evaluation {
    label="modeling and evaluation";
    color="#cbd5e1"; style="rounded"; fontname="Helvetica"; fontsize=13;
    n_ima_modeling_py [label="ima/\nmodeling.py", fillcolor="#fdf2f8"];
    n_ima_pools_py [label="ima/\npools.py", fillcolor="#fdf2f8"];
  }
