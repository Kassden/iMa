#!/usr/bin/env bash
set -euo pipefail

V3_SERVICE=ima-fundamental-v3-supervisor.service
V4_SERVICE=ima-feature-v4-supervisor.service
V3_CAMPAIGN=/home/imaopt/research-v2/campaigns/agentic_v3_fundamental
V4_RELEASE=/home/imaopt/research-v2/live-releases/ima-v4-current
PYTHON=/home/imaopt/research-v2/releases/f54c604/.venv/bin/python
EXPECTED_REVISION=ima-v4-feature-20260930-d

snapshot() {
    "$PYTHON" -c '
import json, sqlite3, sys
from pathlib import Path
campaign = Path(sys.argv[1])
mode = json.loads((campaign / "status.json").read_text()).get("mode", "unknown")
ledger = campaign / "ledger.sqlite"
with sqlite3.connect(f"file:{ledger}?mode=ro", uri=True) as db:
    pending = db.execute(
        "SELECT count(*) FROM attempts WHERE status IN (?, ?)",
        ("running", "reserved"),
    ).fetchone()[0]
print(f"{mode}:{pending}")
' "$V3_CAMPAIGN"
}

check_state() {
    local service_state campaign_state
    service_state=$(systemctl --user is-active "$V3_SERVICE" || true)
    campaign_state=$(snapshot)
    printf 'v3_service=%s v3_campaign=%s v4_revision=%s\n' \
        "$service_state" "$campaign_state" "$(<"$V4_RELEASE/REVISION")"
    [[ "$service_state" == inactive && "$campaign_state" == stopped:0 ]]
}

if [[ "${1:-}" == --check ]]; then
    check_state
    exit $?
fi

while ! check_state; do
    sleep 30
done

[[ $(<"$V4_RELEASE/REVISION") == "$EXPECTED_REVISION" ]] || {
    printf 'Refusing handoff: unexpected v4 release revision.\n' >&2
    exit 1
}
systemctl --user disable "$V3_SERVICE"
systemctl --user enable --now "$V4_SERVICE"
for ((attempt=0; attempt<20; attempt++)); do
    if [[ $(systemctl --user is-active "$V4_SERVICE" || true) == active ]]; then
        printf 'V4 active after graceful v3 handoff.\n'
        exit 0
    fi
    sleep 1
done
printf 'V4 did not become active after handoff.\n' >&2
exit 1
