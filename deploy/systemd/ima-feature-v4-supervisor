#!/usr/bin/env bash
set -u

CAMPAIGN=/home/imaopt/research-v2/campaigns/agentic_v4_features
CODE=/home/imaopt/research-v2/live-releases/ima-v4-current
PYTHON=/home/imaopt/research-v2/releases/f54c604/.venv/bin/python
LOG="$CAMPAIGN/ops/supervisor.log"

mkdir -p "$CAMPAIGN/ops"
exec >>"$LOG" 2>&1
cd "$CODE" || exit 1
test -r "$CODE/REVISION" || exit 1
test -r /home/imaopt/.config/imaopt/openrouter.env || exit 1
set -a
. /home/imaopt/.config/imaopt/openrouter.env
set +a
test -n "${OPENROUTER_API_KEY:-}" || exit 1

export PYTHONPATH="$CODE${PYTHONPATH:+:$PYTHONPATH}"
export IMA_CODE_REVISION
IMA_CODE_REVISION=$(<"$CODE/REVISION")
unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy ALL_PROXY all_proxy

while true; do
    printf 'Starting feature v4 optimizer from %s revision %s at %s\n' \
        "$(readlink -f "$CODE")" "$IMA_CODE_REVISION" "$(date -Is)"
    "$PYTHON" -m scripts.optimize run \
        --campaign "$CAMPAIGN" \
        --config "$CAMPAIGN/ops/openrouter-config.json"
    result=$?
    printf 'Optimizer exited with status %s at %s\n' "$result" "$(date -Is)"
    if [[ $result -eq 0 ]]; then
        mode=$("$PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("mode","unknown"))' "$CAMPAIGN/status.json" 2>/dev/null) || mode=unknown
        if [[ $mode == paused || $mode == paused_admission ]]; then
            sleep 300
            continue
        fi
        exit 0
    fi
    sleep 300
done
