[Unit]
Description=iMa acquisition-only immutable official dataset build and independent readback

[Service]
Type=oneshot
WorkingDirectory=/home/imaopt/acquisition/hkjc-20261002/snapshot-release-r5
Environment=PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
ExecStart=/home/imaopt/acquisition/hkjc-20261002/snapshot-venv-r5/bin/python -m scripts.refresh_official_snapshot \
  --archive /home/imaopt/iMa/data/historical/hkjc-2005-2025 \
  --profiles /home/imaopt/iMa/data/historical/horse-profiles \
  --corpus /home/imaopt/acquisition/hkjc-20261002/corpus \
  --corpus /home/imaopt/acquisition/hkjc-20261002/imports/archive-pilot \
  --corpus /home/imaopt/acquisition/hkjc-20261002/imports/sectional-pilot \
  --corpus /home/imaopt/acquisition/hkjc-20261002/imports/pilot \
  --corpus /home/imaopt/acquisition/hkjc-20261002/imports/pilot-v2 \
  --corpus /home/imaopt/acquisition/hkjc-20261002/imports/daily-json-pilot-v2 \
  --corpus /home/imaopt/acquisition/hkjc-20261002/movement-pilot-r16 \
  --output /home/imaopt/acquisition/hkjc-20261002/snapshots \
  --baseline-runners /home/imaopt/acquisition/hkjc-20261002/imports/local-snapshot-008/runners.parquet \
  --baseline-manifest /home/imaopt/acquisition/hkjc-20261002/imports/local-snapshot-008/manifest.json
TimeoutStartSec=7200
CPUQuota=200%
MemoryHigh=6G
MemoryMax=8G
TasksMax=32
NoNewPrivileges=true
UMask=0077
