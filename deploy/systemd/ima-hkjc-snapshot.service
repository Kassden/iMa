[Unit]
Description=iMa acquisition-only immutable official dataset build and independent readback

[Service]
Type=oneshot
WorkingDirectory=/home/imaopt/acquisition/hkjc-20261002/snapshot-release-r1
Environment=PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
ExecStart=/home/imaopt/acquisition/hkjc-20261002/snapshot-venv/bin/python -m scripts.refresh_official_snapshot --archive /home/imaopt/iMa/data/historical/hkjc-2005-2025 --profiles /home/imaopt/iMa/data/historical/horse-profiles --corpus /home/imaopt/acquisition/hkjc-20261002/corpus --output /home/imaopt/acquisition/hkjc-20261002/snapshots
