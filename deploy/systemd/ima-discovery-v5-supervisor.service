[Unit]
Description=iMa v5 feature discovery and agentic research
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/home/imaopt/research-v2/live-releases/ima-v5-current/deploy/systemd/ima-discovery-v5-supervisor
Restart=on-failure
RestartSec=60
KillMode=control-group
TimeoutStopSec=1800
Nice=5
MemoryHigh=80G
MemoryMax=88G
TasksMax=512

[Install]
WantedBy=default.target
