<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ima.retrain</string>
  <key>WorkingDirectory</key><string>__IMA_REPO__</string>
  <key>ProgramArguments</key><array>
    <string>__IMA_REPO__/.venv/bin/python</string><string>-m</string><string>scripts.train</string>
    <string>--output</string><string>__IMA_REPO__/artifacts/models/latest</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__IMA_REPO__/artifacts/logs/retrain.log</string>
  <key>StandardErrorPath</key><string>__IMA_REPO__/artifacts/logs/retrain-error.log</string>
</dict></plist>
